@* Fellow Pirates project detail *@
<link rel="stylesheet" href="@Url.Content("~/css/project.css")" />
<div class="project project-detail">
    <h2 class="detail-title">Fellow Pirates</h2>
    <partial name="_ProjectCarousel" model="@("fellow_pirates")" />
    <div class="detail-description">
        <a class="detail-play-btn" href="https://evarut.itch.io/fellow-pirates" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round" aria-hidden="true"><path d="M9 7v10l8.5-5z"/></svg>
            Play on itch.io
