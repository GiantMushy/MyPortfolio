         ================================================================ -->

    <div id="project-detail-cleanitwithfire" class="project-detail-section" style="display:none;">
        <a href="#" onclick="showGrid(); return false;" class="back-to-grid btn-primary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Portfolio
        </a>
        <div class="project-detail-wrapper">
            @await Html.PartialAsync("_CleanItWithFire")
