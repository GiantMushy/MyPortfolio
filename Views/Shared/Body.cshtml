                <span class="card-title">Aseprite</span>
            </a>

            <!-- ===== THUMBNAIL: NanAir ===== -->
            <a href="#" onclick="showProject('nanair'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/python-selected.png")" alt="Python" />
                <img class="card-thumbnail" src="@Url.Content("~/images/projects/NanAir.png")" alt="NanAir" />
                <span class="card-title">NanAir</span>
            </a>

            <!-- ===== THUMBNAIL: Naascar 2D ===== -->
            <a href="#" onclick="showProject('cargame2d'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/python-selected.png")" alt="Python" />
                <img class="card-thumbnail" src="@Url.Content("~/images/gifs/CarGame_2D.gif")" alt="Naascar 2D" />
                <span class="card-title">Naascar 2D</span>
            </a>

            <!-- ===== THUMBNAIL: Naascar 3D ===== -->
            <a href="#" onclick="showProject('cargame3d'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/python-selected.png")" alt="Python" />
                <img class="card-thumbnail" src="@Url.Content("~/images/gifs/CarGame_3D.gif")" alt="Naascar 3D" />
                <span class="card-title">Naascar 3D</span>
            </a>

            <!-- ===== THUMBNAIL: Nestor ===== -->
            <a href="#" onclick="showProject('nestor'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/web-selected.png")" alt="Web" />
                <img class="card-thumbnail" src="@Url.Content("~/images/projects/Nestor-frontPage.png")" alt="Nestor" />
                <span class="card-title">Nestor</span>
            </a>

            <!-- ===== THUMBNAIL: Hluthafaskrá (Kóði) ===== -->
            <a href="#" onclick="showProject('kodi'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/web-selected.png")" alt="Web" />
                <img class="card-thumbnail" src="@Url.Content("~/images/projects/Hluthafaskra-forntPage.png")" alt="Hluthafaskrá" />
                <span class="card-title">Hluthafaskrá</span>
            </a>

            <!-- ===== THUMBNAIL: Teaching ===== -->
            <a href="#" onclick="showProject('teaching'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/teaching-selected.png")" alt="Teaching" />
                <img class="card-thumbnail card-thumbnail-icon" src="@Url.Content("~/images/teaching-selected.png")" alt="Teaching" />
                <span class="card-title">Teaching</span>
            </a>

            <!-- ===== THUMBNAIL: Woodworking ===== -->
            <a href="#" onclick="showProject('woodworking'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/woodworking-selected.png")" alt="Woodworking" />
                <img class="card-thumbnail" src="@Url.Content("~/images/projects/Construction/Table.png")" alt="Woodworking" />
                <span class="card-title">Woodworking</span>
            </a>

        </section>

    </div>

    <!-- ================================================================
