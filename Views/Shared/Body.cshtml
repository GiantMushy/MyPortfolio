@* Body partial - Hero Card + Project Thumbnail Grid (Single Page) *@
<link rel="stylesheet" href="@Url.Content("~/css/body.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/project.css")" />

<div class="portfolio-wrapper">

    <!-- ================================================================
         PORTFOLIO VIEW (Hero + Grid) — shown by default
         ================================================================ -->
    <div id="portfolio-view">

        <!-- ===== Hero Card ===== -->
        <section class="hero-card">
            <img class="hero-avatar" src="@Url.Content("~/images/profile.png")" alt="Þorvarður Helgi Bjarnason" />
            <div class="hero-info">
                <h1 class="hero-name">Þorvarður Helgi Bjarnason</h1>
                <p class="hero-title">aspiring developer</p>
                <div class="hero-contacts">
                    <div class="hero-contact-row">
                        <img src="@Url.Content("~/images/personal_email.png")" alt="Email" />
                        <span>thorrib&#64;live.com</span>
                    </div>
                    <div class="hero-contact-row">
                        <img src="@Url.Content("~/images/work_email.png")" alt="Email (RU)" />
                        <span>thorvardur23&#64;ru.is</span>
                    </div>
                    <div class="hero-contact-row">
                        <img src="@Url.Content("~/images/phone.png")" alt="Phone" />
                        <span>(⁺354) 772-2112</span>
                    </div>
                    <div class="hero-contact-row">
                        <img src="@Url.Content("~/images/discord.png")" alt="Discord" />
                        <span>giant_mushroom</span>
                    </div>
                    <div class="hero-contact-row">
                        <img src="@Url.Content("~/images/github.png")" alt="GitHub" />
                        <a href="https://github.com/GiantMushy" target="_blank">github.com/GiantMushy</a>
                    </div>
                    <div class="hero-contact-row">
                        <img src="@Url.Content("~/images/unity-selected.png")" alt="itch.io" />
                        <a href="https://giantmushy.itch.io/" target="_blank">giantmushy.itch.io</a>
                    </div>
                    <div class="hero-contact-row">
                        <img src="@Url.Content("~/images/linkedin.png")" alt="LinkedIn" />
                        <span>Þorvarður Helgi Bjarnason</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===================================================================
             PROJECT THUMBNAILS
             To change a thumbnail image, edit the src attribute on the
             <img class="card-thumbnail"> element for that project.
             =================================================================== -->
        <section class="thumbnail-grid">

            <!-- ===== THUMBNAIL: Clean It With Fire ===== -->
            <a href="#" onclick="showProject('cleanitwithfire'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/unity-selected.png")" alt="Unity" />
                <img class="card-thumbnail" src="@Url.Content("~/images/projects/CleanItWithFire-viscera.png")" alt="Clean It With Fire" />
                <span class="card-title">Clean It With Fire</span>
            </a>

            <!-- ===== THUMBNAIL: Fellow Pirates ===== -->
            <a href="#" onclick="showProject('fellowpirates'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/unity-selected.png")" alt="Unity" />
                <img class="card-thumbnail" src="@Url.Content("~/images/projects/FellowPirates.png")" alt="Fellow Pirates" />
                <span class="card-title">Fellow Pirates</span>
            </a>

            <!-- ===== THUMBNAIL: Cult of the Jarls ===== -->
            <a href="#" onclick="showProject('cultofthejarls'); return false;" class="project-card">
                <img class="card-category-icon" src="@Url.Content("~/images/unity-selected.png")" alt="Unity" />
                <img class="card-thumbnail" src="@Url.Content("~/images/projects/TLJ-bigPicture.png")" alt="Cult of the Jarls" />
                <span class="card-title">Cult of the Jarls</span>
            </a>

            <!-- ===== THUMBNAIL: Aseprite ===== -->
            <a href="#" onclick="showProject('aseprite'); return false;" class="project-card">
